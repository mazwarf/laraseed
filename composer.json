{
    "name": "azwar/laraseed",
    "description": "The Ultimate Laravel Auto Generator for Factories and Seeders powered by AI.",
    "type": "library",
    "keywords": [
        "laravel",
        "generator",
        "factory",
        "seeder",
        "policy",
        "artisan",
        "automation",
        "php-parser"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Azwar",
            "email": "azwar@example.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Azwar\\Laraseed\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Azwar\\Laraseed\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Azwar\\Laraseed\\LaraseedServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
